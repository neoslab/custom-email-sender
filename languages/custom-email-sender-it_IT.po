#: admin/class-custom-email-sender-admin.php:74
msgid "Custom Email Sender"
msgstr "Custom Email Sender"

#: admin/class-custom-email-sender-admin.php:86
msgid "Settings"
msgstr "Impostazioni"

#: admin/partials/custom-email-sender-admin-options.php:4
msgid "Your settings have been successfully updated."
msgstr "Le tue impostazioni sono state aggiornate con successo."

#: admin/partials/custom-email-sender-admin-options.php:10
msgid "The email address is not valid !!"
msgstr "L'indirizzo email non è valido!!"

#: admin/partials/custom-email-sender-admin-options.php:14
msgid "The sender name is not valid !!"
msgstr "Il nome del mittente non è valido!!"

#: admin/partials/custom-email-sender-admin-options.php:18
msgid "An unknown error occured !!"
msgstr "Si è verificato un errore sconosciuto!!"

#: admin/partials/custom-email-sender-admin-options.php:38
msgid "You have not set up your sender name and email address ! In order to do so, please use the below form."
msgstr "Non hai impostato il nome del mittente e l'indirizzo email! Per farlo, utilizza il modulo sottostante."

#: admin/partials/custom-email-sender-admin-options.php:43
msgid "Your plugin is properly configured ! You can change at anytime your sender name and email address using the below form."
msgstr "Il tuo plugin è configurato correttamente! Puoi modificare in qualsiasi momento il nome del mittente e l'indirizzo email utilizzando il modulo sottostante."

#: admin/partials/custom-email-sender-admin-options.php:52
msgid "Sender Name"
msgstr "Nome Mittente"

#: admin/partials/custom-email-sender-admin-options.php:53
msgid "Enter the sender name"
msgstr "Inserisci il nome del mittente"

#: admin/partials/custom-email-sender-admin-options.php:54
msgid "Enter the sender name as you want it to appear when email are sent (Min. 3 characters)."
msgstr "Inserisci il nome del mittente come vuoi che appaia quando vengono inviate le email (Min. 3 caratteri)."

#: admin/partials/custom-email-sender-admin-options.php:58
msgid "Sender Email"
msgstr "Email Mittente"

#: admin/partials/custom-email-sender-admin-options.php:59
msgid "Enter the email address"
msgstr "Inserisci l'indirizzo email"

#: admin/partials/custom-email-sender-admin-options.php:60
msgid "Enter the sender email as you want it to appear when email are sent (Must be a valid email address)."
msgstr "Inserisci l'email del mittente come vuoi che appaia quando vengono inviate le email (Deve essere un indirizzo email valido)."

#: admin/partials/custom-email-sender-admin-options.php:63
msgid "Update Settings"
msgstr "Aggiorna Impostazioni"

#. Plugin URI of the plugin/theme
msgid "https://wordpress.org/plugins/custom-email-sender/"
msgstr "https://wordpress.org/plugins/custom-email-sender/"

#. Description of the plugin/theme
msgid "Change the default email address and sender name output for all message sent from your WP dashboard."
msgstr "Modifica l'indirizzo email predefinito e il nome del mittente per tutti i messaggi inviati dalla tua dashboard WP."

#. Author of the plugin/theme
msgid "NeosLab"
msgstr "NeosLab"

#. Author URI of the plugin/theme
msgid "https://neoslab.com"
msgstr "https://neoslab.com"